            "$ref": "#/$defs/EmailHit"
          },
          {
            "$ref": "#/$defs/FileHit"
          },
          {
            "$ref": "#/$defs/MessageHit"
          },
          {
            "$ref": "#/$defs/PageHit"
          }
        ]
      },
