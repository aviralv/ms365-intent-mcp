    },
    "query": {
      "title": "Query",
      "type": "string"
    },
    "rendered_markdown": {
      "title": "Rendered Markdown",
      "type": "string"
    },
    "type": {
      "const": "find_results",
      "default": "find_results",
      "title": "Type",
      "type": "string"
    }
