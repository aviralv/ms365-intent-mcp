{
  "$defs": {
    "Recipient": {
      "additionalProperties": false,
      "description": "One email recipient. Used in email draft payloads.",
      "properties": {
        "email": {
          "description": "RFC 5322 email address",
          "format": "email",
          "title": "Email",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        }
      },
      "required": [
        "email"
      ],
      "title": "Recipient",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Draft an email \u2014 new, reply, reply_all, or forward.\n\nMode-specific field requirements are enforced by ``_check_mode_fields``:\n- ``mode='new'`` requires ``to`` and ``subject``\n- ``mode='reply' | 'reply_all' | 'forward'`` requires ``in_reply_to_message_id``",
  "properties": {
    "body": {
      "description": "HTML supported.",
      "minLength": 1,
      "title": "Body",
      "type": "string"
    },
    "cc": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/Recipient"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cc"
    },
    "comment": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Comment"
    },
    "idempotency_key": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Idempotency Key"
    },
    "importance": {
      "default": "normal",
      "enum": [
        "low",
        "normal",
        "high"
      ],
      "title": "Importance",
      "type": "string"
    },
    "in_reply_to_message_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "In Reply To Message Id"
    },
    "mode": {
      "default": "new",
      "enum": [
        "new",
        "reply",
        "reply_all",
        "forward"
      ],
      "title": "Mode",
      "type": "string"
    },
    "subject": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Subject"
    },
    "to": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/Recipient"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "To"
    },
    "type": {
      "const": "email",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "type",
    "body"
  ],
  "title": "ComposeEmail",
  "type": "object"
}
