      "type": "string"
    },
    "kind": {
      "const": "email",
      "title": "Kind",
      "type": "string"
    },
    "sender": {
      "title": "Sender",
      "type": "string"
    },
    "subject": {
      "title": "Subject",
      "type": "string"
    }
  },
  "required": [
    "kind",
    "subject",
    "sender",
    "body"
