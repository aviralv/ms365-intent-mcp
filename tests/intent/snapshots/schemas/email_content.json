          "type": "string"
        },
        "cid": {
          "default": "",
          "title": "Cid",
          "type": "string"
        },
        "content_type": {
          "default": "",
          "title": "Content Type",
          "type": "string"
        },
        "is_inline": {
          "default": false,
          "title": "Is Inline",
          "type": "boolean"
        },
        "local_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Local Path"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "size": {
          "default": 0,
