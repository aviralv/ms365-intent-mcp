{
  "$defs": {
    "FileAttachment": {
      "additionalProperties": false,
      "description": "A reference attachment (link to an existing OneDrive/SharePoint file).",
      "properties": {
        "name": {
          "description": "Display name (e.g. 'report.xlsx').",
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "url": {
          "description": "SharePoint or OneDrive URL of the file.",
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "name",
        "url"
      ],
      "title": "FileAttachment",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Send a Teams chat message, optionally with file attachments.",
  "properties": {
    "attachments": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/FileAttachment"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional file attachments (OneDrive/SharePoint URLs) to include.",
      "title": "Attachments"
    },
    "chat_id": {
      "minLength": 1,
      "title": "Chat Id",
      "type": "string"
    },
    "content": {
      "minLength": 1,
      "title": "Content",
      "type": "string"
    },
    "content_type": {
      "default": "text",
      "enum": [
        "text",
        "html"
      ],
      "title": "Content Type",
      "type": "string"
    },
    "idempotency_key": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Idempotency Key"
    },
    "type": {
      "const": "teams_message",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "type",
    "chat_id",
    "content"
  ],
  "title": "ComposeTeamsMessage",
  "type": "object"
}
