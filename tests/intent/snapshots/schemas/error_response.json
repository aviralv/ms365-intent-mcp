{
  "additionalProperties": false,
  "description": "Uniform error envelope. Any tool can return this on failure.",
  "properties": {
    "code": {
      "enum": [
        "not_found",
        "insufficient_scope",
        "invalid_id",
        "graph_api_error",
        "validation_error",
        "rate_limited"
      ],
      "title": "Code",
      "type": "string"
    },
    "message": {
      "title": "Message",
      "type": "string"
    },
    "retryable": {
      "default": false,
      "title": "Retryable",
      "type": "boolean"
    },
    "type": {
      "const": "error",
      "default": "error",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "code",
    "message"
  ],
  "title": "ErrorResponse",
  "type": "object"
}
